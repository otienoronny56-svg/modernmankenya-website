# Modern Man Kenya 254 - Environment Configuration Template
# Public Client Keys (Safe for Browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://modernmanke.com

# STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER / NEVER PREFIX WITH NEXT_PUBLIC_
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# M-Pesa Daraja Configuration
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=542542
MPESA_CALLBACK_URL=https://www.modernmanke.com/api/payments/mpesa/callback

# ==========================================
# Automated Email System (SMTP Configuration)
# ==========================================
# Compatible with Resend SMTP, Namecheap Private Email, Zoho, Gmail, etc.
# 
# Option A: Resend SMTP (Recommended)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_123456789...
# SMTP_FROM="Modern Man Kenya" <concierge@modernmanke.com>
#
# Option B: Namecheap Private Email SMTP
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_USER=concierge@modernmanke.com
# SMTP_PASS=your_mailbox_password
# SMTP_FROM="Modern Man Kenya" <concierge@modernmanke.com>
